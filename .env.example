# TrustPK environment template — copy to .env and fill in values.
# Never commit real secrets.

# PostgreSQL
POSTGRES_DB=trustpk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=25432

# Backend connects to the Docker Compose service name "db" inside the network.
DATABASE_URL=postgresql://postgres:change_me_strong_password@db:5432/trustpk

BACKEND_PORT=8000
FRONTEND_PORT=3000

# Comma-separated CORS origins for the browser frontend.
# Example for PC + phone on the same Wi-Fi:
# FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://YOUR_PC_LAN_IP:3000
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Browser-accessible FastAPI URL (used by client-side JavaScript).
# For phone testing, set this to http://YOUR_PC_LAN_IP:8000
# Find YOUR_PC_LAN_IP with: ipconfig   (look for Wi-Fi IPv4 Address)
# Do NOT use Docker hostnames (backend/db) here — browsers cannot resolve them.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to false to hide the homepage API connectivity badge
NEXT_PUBLIC_SHOW_API_STATUS=true
ENVIRONMENT=development
